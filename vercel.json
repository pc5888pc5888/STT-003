{
  "rewrites": [
    {
      "source": "/navigator",
      "destination": "/gcsda-navigator.html"
    },
    {
      "source": "/en/navigator",
      "destination": "/gcsda-en-navigator.html"
    },
    {
      "source": "/en",
      "destination": "/gcsda-en.html"
    },
    {
      "source": "/en/about",
      "destination": "/gcsda-en-about.html"
    },
    {
      "source": "/en/governance",
      "destination": "/gcsda-en-governance.html"
    },
    {
      "source": "/en/membership",
      "destination": "/gcsda-en-membership.html"
    },
    {
      "source": "/about",
      "destination": "/gcsda-about.html"
    },
    {
      "source": "/founder-chairman",
      "destination": "/gcsda-founder-chairman.html"
    },
    {
      "source": "/governance",
      "destination": "/gcsda-governance.html"
    },
    {
      "source": "/council",
      "destination": "/gcsda-council.html"
    },
    {
      "source": "/membership",
      "destination": "/gcsda-membership.html"
    },
    {
      "source": "/events",
      "destination": "/gcsda-events.html"
    },
    {
      "source": "/knowledge",
      "destination": "/gcsda-knowledge.html"
    },
    {
      "source": "/charter",
      "destination": "/gcsda-charter.html"
    },
    {
      "source": "/privacy",
      "destination": "/gcsda-privacy.html"
    }
  ],
  "redirects": [
    {
      "source": "/navigator/",
      "destination": "/navigator",
      "permanent": true
    },
    {
      "source": "/en/navigator/",
      "destination": "/en/navigator",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/en/about/",
      "destination": "/en/about",
      "permanent": true
    },
    {
      "source": "/en/governance/",
      "destination": "/en/governance",
      "permanent": true
    },
    {
      "source": "/en/membership/",
      "destination": "/en/membership",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/governance.html",
      "destination": "/governance",
      "permanent": true
    },
    {
      "source": "/insights.html",
      "destination": "/knowledge",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/membership",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
