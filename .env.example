# STT Governance server-only runtime configuration
# Never prefix secrets with VITE_. Front-end code must call same-origin server endpoints only.

# Dify
DIFY_API_BASE_URL=
DIFY_API_KEY=
DIFY_APP_ID=

# Text-to-speech provider selection: openai or elevenlabs
TTS_PROVIDER=openai

# OpenAI TTS
OPENAI_API_KEY=
OPENAI_TTS_API_URL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_API_URL=
ELEVENLABS_MODEL_ID=

# Humanistic interview transactional email (preferred)
RESEND_API_KEY=
RESEND_FROM_EMAIL=STT 人文地景產 <onboarding@resend.dev>

# Legacy server-side contact delivery fallback
EMAILJS_API_URL=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Public application origin used only by server-side functions when needed
APP_URL=
