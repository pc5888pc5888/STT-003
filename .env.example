# STT Governance server-only runtime configuration
# Never prefix secrets with VITE_. Front-end code must call same-origin server endpoints only.

# Dify
DIFY_API_BASE_URL=
DIFY_API_KEY=
DIFY_APP_ID=

# Text-to-speech provider selection: openai or elevenlabs
TTS_PROVIDER=openai

# OpenAI TTS
OPENAI_API_KEY=
OPENAI_TTS_API_URL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_API_URL=
ELEVENLABS_MODEL_ID=

# Public application origin used only by server-side functions when needed
APP_URL=
