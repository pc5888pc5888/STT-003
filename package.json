{
  "name": "stt-governance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/validate-presentation.mjs && node scripts/validate-english-foundation.mjs && node scripts/line/validate-stt-webhook.mjs && node scripts/line/validate-gcsda-delivery-relay.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/finalize-interview.mjs",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "line:future:verify": "node scripts/line/verify-future-package.mjs",
    "line:release:check": "node scripts/line/check-release-gate.mjs",
    "line:candidate:promote:stt": "node scripts/line/promote-approved-candidate.mjs stt",
    "line:candidate:promote:gcsda": "node scripts/line/promote-approved-candidate.mjs gcsda",
    "line:capability:audit": "node scripts/line/audit-public-capabilities.mjs",
    "line:static:check": "node scripts/line/check-static-readiness.mjs",
    "line:prep:lock": "node scripts/line/check-prep-lock.mjs",
    "line:status": "node scripts/line/check-progress.mjs",
    "line:webhook:check:stt": "node scripts/line/validate-stt-webhook.mjs",
    "line:relay:check": "node scripts/line/validate-gcsda-delivery-relay.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@emailjs/browser": "^4.4.1",
    "@google/generative-ai": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "latest",
    "express": "^4.19.2",
    "lenis": "^1.3.23",
    "lucide-react": "latest",
    "motion": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "tailwind-merge": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/express": "^4.17.21",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.1"
  }
}
